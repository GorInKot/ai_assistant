# LLM-бэкенд: любой OpenAI-совместимый API.
# Локально (рекомендуется, данные не покидают машину): Ollama, `ollama pull ministral-3:3b`.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=ministral-3:3b
# Отключает «размышления» у моделей, которые их умеют (Qwen3.5 и т.п.); внешним API не нужен.
LLM_REASONING_EFFORT=none

# Облачная альтернатива (Groq, бесплатный ключ на https://console.groq.com/keys):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=...
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_REASONING_EFFORT=

# Rerank (0 — быстрее; на небольших локальных моделях LLM-rerank слишком медленный)
ENABLE_LLM_RERANK=0
RERANK_CANDIDATES=28
RERANK_TOP_N=16

# Секрет подписи JWT — задайте случайную строку:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# База знаний и логи
KB_ROOT=knowledge_base
LOG_FILE=logs/assistant.log

# Векторный поиск (Yandex Foundation Models / text-search-doc + text-search-query).
# Если оба заполнены — KB-индекс посчитает эмбеддинги при build() и будет использовать
# hybrid retrieval (BM25 + cosine). Если пусто — работает только лексический BM25.
# Получить ключи: https://yandex.cloud/ru/docs/foundation-models/
# Локальные эмбеддинги через Ollama (приоритетнее Yandex):
# EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDINGS_MODEL=qwen3-embedding:0.6b
# EMBEDDINGS_QUERY_PREFIX=Instruct: Given a user question about corporate processes, retrieve passages that answer it\nQuery: 
YC_API_KEY=
YC_FOLDER_ID=
EMBEDDINGS_CACHE=logs/embeddings_cache.npz

# Email-уведомления о новых заявках (опционально). Если SMTP_HOST и SMTP_FROM
# заданы — назначенному ответственному уходит письмо при создании заявки.
# Если пусто — уведомления отключены (no-op), на работу заявок не влияет.
# Пример для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<почта>,
# SMTP_PASSWORD=<app password>, SMTP_FROM=<почта>, SMTP_USE_TLS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Конструктор деталей: каталог с SolidCraft (ставится scripts/fetch_solidcraft.sh)
# SOLIDCRAFT_DIR=tools/solidcraft

# Чертёж трассы: каталог с CADCraft (ставится scripts/fetch_cadcraft.sh)
# CADCRAFT_DIR=tools/cadcraft

# Закрытый контур: модели вне этой машины и внутренней сети отключаются при старте.
# Сервер с моделью во внутренней сети по имени — через запятую:
# INTERNAL_HOSTS=gpu.corp
# Разрешить облачные модели (не для закрытого контура):
# ALLOW_EXTERNAL_MODELS=1

# Вход из корпоративного портала (integrations/portal/README.md):
# общий секрет не короче 32 символов — тот же, что ASSISTANT_SSO_SECRET портала
# PORTAL_SSO_SECRET=
# адреса портала, которым разрешено встраивать ассистент (через пробел)
# PORTAL_ORIGINS=http://127.0.0.1:8080 http://localhost:8080
